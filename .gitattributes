# Normalize text files to LF
* text=auto eol=lf

# Common source and configuration files
*.c      text
*.cc     text
*.cpp    text
*.css    text
*.csv    text
*.go     text
*.h      text
*.hpp    text
*.html   text
*.java   text
*.js     text
*.json   text
*.jsx    text
*.md     text
*.py     text
*.rb     text
*.rs     text
*.sh     text eol=lf
*.sql    text
*.svg    text
*.toml   text
*.ts     text
*.tsx    text
*.txt    text
